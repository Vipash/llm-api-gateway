# Copy to .env and adjust as needed.
# App reads this via pydantic-settings (see app/config.py).

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway
REDIS_URL=redis://localhost:6379/0

# Local Ollama OpenAI-compatible API. Swap host later for OpenAI:
#   https://api.openai.com/v1
LLM_PROVIDER_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.2

# Optional. Used when proxying to OpenAI (or any provider that needs a bearer token).
OPENAI_API_KEY=
